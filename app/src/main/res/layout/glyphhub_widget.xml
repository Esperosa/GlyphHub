<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_inactive"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_top_hint"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:clickable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="^"
            android:textColor="#8A8A8A"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_left_hint"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="&lt;"
                android:textColor="#8A8A8A"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/widget_center_zone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_preview"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:adjustViewBounds="false"
                    android:contentDescription="@string/widget_description"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_toy_name"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="IDLE"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_right_hint"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="&gt;"
                android:textColor="#8A8A8A"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_bottom_hint"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:clickable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="v"
            android:textColor="#8A8A8A"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_panel_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:background="@drawable/widget_card_inactive"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_panel_top_hint"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:clickable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="^"
            android:textColor="#8A8A8A"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_panel_left_hint"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="-"
                android:textColor="#8A8A8A"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_panel_scope"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="TOY"
                    android:textColor="#8A8A8A"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_panel_title"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="SETTING"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_panel_value"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="@color/glyph_red"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_panel_close"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:text="" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_panel_right_hint"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="+"
                android:textColor="#8A8A8A"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_panel_bottom_hint"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:clickable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="v"
            android:textColor="#8A8A8A"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
